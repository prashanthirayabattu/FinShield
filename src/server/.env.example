# FinShield Server Configuration
# Copy this file to .env and supply actual values in deployment/production.
# Never commit .env or real credentials to the Git repository.

DATABASE_URL=postgresql://user:password@localhost:5432/finshield?schema=public
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
